<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>호그와트 페어틀 메이커</title>
  <!-- 이미지 저장 기능을 위한 html2canvas 라이브러리 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <style>
    :root {
      /* 기본(회색) 테마 색상 정의 */
      --bg-color: #f7f9fa;
      --card-bg: #ffffff;
      --main-color: #4a5568;
      --sub-color: #a0aec0;
      --border-color: #2d3748;
      --text-color: #1a202c;
    }

    /* 테마 데이터 정의 */
    [data-theme="gryffindor"] {
      --bg-color: #fdf8f8;
      --main-color: #740001;
      --sub-color: #d3a625;
      --border-color: #740001;
      --text-color: #3b0000;
    }
    [data-theme="slytherin"] {
      --bg-color: #f4f8f5;
      --main-color: #1a472a;
      --sub-color: #8d99ae;
      --border-color: #1a472a;
      --text-color: #0d2516;
    }
    [data-theme="ravenclaw"] {
      --bg-color: #f4f6fb;
      --main-color: #0e1a40;
      --sub-color: #946b2d;
      --border-color: #0e1a40;
      --text-color: #070d21;
    }
    [data-theme="hufflepuff"] {
      --bg-color: #fffdf5;
      --main-color: #ecb939;
      --sub-color: #372e29;
      --border-color: #372e29;
      --text-color: #231d1a;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Pretendard', 'Noto Sans KR', sans-serif;
    }

    body {
      background-color: #e2e8f0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
      gap: 20px;
    }

    /* 컨트롤 패널 */
    .control-panel {
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 600px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .house-tabs {
      display: flex;
      gap: 8px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .tab-btn {
      padding: 8px 14px;
      border: 2px solid #cbd5e0;
      background: white;
      border-radius: 20px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.2s;
    }

    .tab-btn.active {
      background: #2d3748;
      color: white;
      border-color: #2d3748;
    }

    .input-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .input-box {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 14px;
    }

    .input-box input[type="text"], .input-box input[type="file"] {
      padding: 6px 10px;
      border: 1px solid #cbd5e0;
      border-radius: 4px;
    }

    .save-btn {
      padding: 12px;
      background: #3182ce;
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }
    .save-btn:hover { background: #2b6cb0; }

    /* 페어틀 카드 메인 (러프 구조 구현) */
    .pair-card {
      width: 500px;
      height: 680px;
      background-color: var(--card-bg);
      border: 1px solid #cbd5e0;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 40px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
      transition: background-color 0.3s;
    }

    /* 사선 스트라이프 */
    .stripes {
      position: absolute;
      width: 200px;
      height: 200px;
      pointer-events: none;
    }

    .stripes-top-left {
      top: -80px;
      left: -80px;
      transform: rotate(-45deg);
    }

    .stripes-bottom-right {
      bottom: -80px;
      right: -80px;
      transform: rotate(-45deg);
    }

    .stripe-line {
      height: 16px;
      margin-bottom: 12px;
      background-color: var(--main-color);
      transition: background-color 0.3s;
    }
    .stripe-line.sub {
      background-color: var(--sub-color);
    }

    /* 중간 구분선 */
    .middle-divider {
      width: 100%;
      height: 8px;
      background-color: var(--main-color);
      margin: 20px 0;
      border-radius: 4px;
      transition: background-color 0.3s;
    }

    /* 캐릭터 섹션 */
    .char-section {
      display: flex;
      flex-direction: column;
      z-index: 1;
    }

    .char-top {
      align-items: flex-end;
    }

    .char-bottom {
      align-items: flex-start;
    }

    /* 프로필 이미지 박스 */
    .profile-box {
      width: 160px;
      height: 160px;
      border: 4px solid var(--border-color);
      background-color: #edf2f7;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: border-color 0.3s;
    }

    .profile-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* 이름 박스 */
    .name-box {
      margin: 8px 0;
      display: flex;
      flex-direction: column;
      color: var(--text-color);
    }

    .char-top .name-box {
      text-align: right;
    }

    .char-bottom .name-box {
      text-align: left;
    }

    .kr-name {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .en-name {
      font-size: 14px;
      font-weight: 500;
      opacity: 0.8;
      text-transform: uppercase;
    }
  </style>
</head>
<body>

  <!-- 입력 & 제어 패널 -->
  <div class="control-panel">
    <!-- 기숙사 탭 -->
    <div class="house-tabs">
      <button class="tab-btn active" onclick="setTheme('default', this)">기본(회색)</button>
      <button class="tab-btn" onclick="setTheme('gryffindor', this)">그리핀도르</button>
      <button class="tab-btn" onclick="setTheme('slytherin', this)">슬리데린</button>
      <button class="tab-btn" onclick="setTheme('ravenclaw', this)">래번클로</button>
      <button class="tab-btn" onclick="setTheme('hufflepuff', this)">후플푸프</button>
    </div>

    <!-- 캐릭터 1 & 2 정보 입력 -->
    <div class="input-group">
      <div class="input-box">
        <strong>상단 캐릭터 (우측)</strong>
        <input type="file" accept="image/*" onchange="loadImg(event, 'img1')">
        <input type="text" placeholder="한글 이름" oninput="updateText('kr1', this.value)">
        <input type="text" placeholder="영어 이름" oninput="updateText('en1', this.value)">
      </div>
      <div class="input-box">
        <strong>하단 캐릭터 (좌측)</strong>
        <input type="file" accept="image/*" onchange="loadImg(event, 'img2')">
        <input type="text" placeholder="영어 이름" oninput="updateText('en2', this.value)">
        <input type="text" placeholder="한글 이름" oninput="updateText('kr2', this.value)">
      </div>
    </div>

    <button class="save-btn" onclick="downloadTemplate()">이미지로 저장하기</button>
  </div>

  <!-- 페어틀 출력 영역 -->
  <div class="pair-card" id="pairCard" data-theme="default">
    <!-- 좌상단 스트라이프 -->
    <div class="stripes stripes-top-left">
      <div class="stripe-line"></div>
      <div class="stripe-line sub"></div>
    </div>

    <!-- 상단 캐릭터 영역 (우측 배치) -->
    <div class="char-section char-top">
      <div class="profile-box">
        <img id="img1" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 24 24' fill='none' stroke='%23cbd5e0' stroke-width='1.5'><rect x='3' y='3' width='18' height='18' rx='2'/><circle cx='8.5' cy='8.5' r='1.5'/><path d='M21 15l-5-5L5 21'/></svg>" alt="Proflie 1">
      </div>
      <div class="name-box">
        <span class="kr-name" id="txt-kr1">한글 이름</span>
        <span class="en-name" id="txt-en1">ENGLISH NAME</span>
      </div>
    </div>

    <!-- 중앙 구분선 -->
    <div class="middle-divider"></div>

    <!-- 하단 캐릭터 영역 (좌측 배치) -->
    <div class="char-section char-bottom">
      <div class="name-box">
        <span class="en-name" id="txt-en2">ENGLISH NAME</span>
        <span class="kr-name" id="txt-kr2">한글 이름</span>
      </div>
      <div class="profile-box">
        <img id="img2" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 24 24' fill='none' stroke='%23cbd5e0' stroke-width='1.5'><rect x='3' y='3' width='18' height='18' rx='2'/><circle cx='8.5' cy='8.5' r='1.5'/><path d='M21 15l-5-5L5 21'/></svg>" alt="Profile 2">
      </div>
    </div>

    <!-- 우하단 스트라이프 -->
    <div class="stripes stripes-bottom-right">
      <div class="stripe-line"></div>
      <div class="stripe-line sub"></div>
    </div>
  </div>

  <script>
    // 테마 변경 함수
    function setTheme(themeName, btn) {
      document.getElementById('pairCard').setAttribute('data-theme', themeName);
      
      // 탭 버튼 활성화 상태 변경
      const buttons = document.querySelectorAll('.tab-btn');
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    // 텍스트 실시간 반영
    function updateText(id, val) {
      const target = document.getElementById('txt-' + id);
      if (id.startsWith('kr')) {
        target.innerText = val || '한글 이름';
      } else {
        target.innerText = val ? val.toUpperCase() : 'ENGLISH NAME';
      }
    }

    // 이미지 업로드 반영
    function loadImg(event, targetId) {
      const reader = new FileReader();
      reader.onload = function() {
        const output = document.getElementById(targetId);
        output.src = reader.result;
      };
      if (event.target.files[0]) {
        reader.readAsDataURL(event.target.files[0]);
      }
    }

    // 페어틀 PNG 다운로드
    function downloadTemplate() {
      const card = document.getElementById('pairCard');
      html2canvas(card, { scale: 2 }).then(canvas => {
        const link = document.createElement('a');
        link.download = 'hogwarts_pair_template.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }
  </script>
</body>
</html>
